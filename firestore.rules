rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helpers de autenticación y roles
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * FASE 0 — Administrador sin lecturas.
     *
     * Primero se evalúa el custom claim (`request.auth.token.admin`), que no
     * cuesta lecturas. El `exists()` queda como puente SOLO durante la
     * migración, para que el panel de administración siga funcionando antes
     * de setear los claims.
     *
     * Cuando todos los admin tengan el claim:
     *   1) verifica el panel con un admin real,
     *   2) borra la línea del `exists()`.
     *
     * Nota: en las consultas del dueño, `isOwner(userId) || isAdmin()`
     * cortocircuita en `isOwner`, así que un negocio NUNCA paga el `exists()`.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    /**
     * Roles globales: solo el propio admin puede consultar su registro.
     * El cliente no lee esta colección (usa el claim / profile.isAdmin).
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow read, write: if false;
    }

    /**
     * Anuncios globales
     */
    match /system/announcements {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * Estructura multi-tenant: cada negocio solo ve sus datos.
     * `list` sobre /users queda restringido a admin (evita descargar todos
     * los perfiles desde el cliente).
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();

      match /{allData=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
