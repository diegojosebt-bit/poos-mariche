rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helpers de autenticación y roles
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * FASE 0 — Administrador sin lecturas.
     *
     * Primero se evalúa el custom claim (`request.auth.token.admin`), que no
     * cuesta lecturas. El `exists()` queda como puente SOLO durante la
     * migración, para que el panel de administración siga funcionando antes
     * de setear los claims.
     *
     * Cuando todos los admin tengan el claim:
     *   1) verifica el panel con un admin real,
     *   2) borra la línea del `exists()`.
     *
     * Nota: en las consultas del dueño, `isOwner(userId) || isAdmin()`
     * cortocircuita en `isOwner`, así que un negocio NUNCA paga el `exists()`.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    /**
     * Roles globales: solo el propio admin puede consultar su registro.
     * El cliente no lee esta colección (usa el claim / profile.isAdmin).
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow read, write: if false;
    }

    /**
     * Anuncios globales
     */
    match /system/announcements {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * Estructura multi-tenant: cada negocio solo ve sus datos.
     * `list` sobre /users queda restringido a admin (evita descargar todos
     * los perfiles desde el cliente).
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // El registro público solo puede crear cuentas pendientes; nunca activas ni con cupos/roles forjados.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.licenseStatus == 'pending' &&
        request.resource.data.isAdmin != true &&
        !request.resource.data.keys().hasAny([
          'planTier', 'maxRegisters', 'maxCashiers', 'cashiers', 'activeSessions'
        ])
      );
      // El dueño no puede modificarse la licencia, su plan/cupos ni darse permisos de admin.
      // Si edita la lista de cajeros, Firestore valida que nunca exceda `maxCashiers`.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'licenseStatus', 'licenseExpiry', 'isAdmin', 'uid', 'createdAt',
          'planTier', 'maxRegisters', 'maxCashiers'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cashiers']) ||
          (
            request.resource.data.cashiers is list &&
            request.resource.data.cashiers.size() <= (
              ('maxCashiers' in resource.data && resource.data.maxCashiers is int)
                ? resource.data.maxCashiers
                : 2
            )
          )
        )
      );
      allow delete: if isAdmin();

      match /{allData=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
